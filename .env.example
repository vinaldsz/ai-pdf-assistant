# Example environment variables for the AI PDF Assistant.
# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
#
# All vars are loaded + validated by app/settings.py at import time.
# Missing required vars will raise a clear ValidationError on startup.

# ============ Required ============

# Groq — LLM completions. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Postgres + pgvector. Examples:
#   Local Docker:  postgresql://ai:ai@localhost:5432/ai
#   Neon:          postgresql://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://ai:ai@localhost:5432/ai


# ============ Optional (used on later days) ============

# Cloudflare R2 — PDF blob storage (Day 10)
# R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=ai-pdf-assistant

# Langfuse Cloud — LLM tracing (Day 7). Sign up at https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com


# ============ Tunables (override defaults from app/settings.py) ============

# LLM_MODEL=llama-3.3-70b-versatile
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DIM=384
# RERANKER_MODEL=BAAI/bge-reranker-base
# CHUNK_SIZE=800
# CHUNK_OVERLAP=120
# TOP_K=20
# RERANK_K=5
# MIN_SIMILARITY=0.30
# ENVIRONMENT=dev
# LOG_LEVEL=INFO
